# ==========================================
# KnowledgeOS Environment Configuration
# ==========================================

# 1. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. LLM Providers
# Obtain an NVIDIA API key from: https://build.nvidia.com/
# Real models: meta/llama-3.3-70b-instruct, nvidia/llama-3.2-nv-embedqa-1b-v2, etc.
NVIDIA_API_KEY=

# Obtain an OpenRouter API key from: https://openrouter.ai/keys
# Real models: google/gemini-2.0-flash-exp:free, meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-r1:free, etc.
OPENROUTER_API_KEY=

# Default Active Provider: "nvidia" or "openrouter"
DEFAULT_AI_PROVIDER=openrouter

# Default Model Identifier (must match provider's catalog)
# NVIDIA examples: "meta/llama-3.3-70b-instruct", "mistralai/mistral-large-2407"
# OpenRouter examples: "google/gemini-2.0-flash-exp:free", "meta-llama/llama-3.3-70b-instruct", "anthropic/claude-3.5-sonnet"
DEFAULT_AI_MODEL=google/gemini-2.0-flash-exp:free

# Default Embedding Model
# NVIDIA example: "nvidia/llama-3.2-nv-embedqa-1b-v2"
# Fallback / Built-in lightweight embeddings are automatically enabled when no key is provided
EMBEDDING_MODEL=text-embedding-3-small

# 3. Supabase & Database (PostgreSQL with pgvector)
# Get your credentials at: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string (with pgvector extension enabled)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# 4. Authentication & Security
AUTH_SECRET=your-random-32-character-secret-key-here

# 5. Application Defaults
# Enables demo mode by default if database or API keys are not yet connected
NEXT_PUBLIC_DEFAULT_DEMO_MODE=true
NEXT_PUBLIC_APP_NAME="KnowledgeOS"
NEXT_PUBLIC_ORGANIZATION_NAME="Acme Corp"
